        public Form1()
        {
            InitializeComponent();
            InicializarDatosPrueba();
            CargarCombos();
        }
        private List<Sucursal> listaSucursales = new List<Sucursal>();
        private List<Medicamento> catalogoMedicamentos = new List<Medicamento>();
        private List<InventarioItem> listaInventario = new List<InventarioItem>();
        private int siguienteIdInventario = 1;

  
        private void InicializarDatosPrueba()
        {
           
            listaSucursales = new List<Sucursal>
            {
                new Sucursal { IdSucursal = 1, Nombre = "Cantera" },
                new Sucursal { IdSucursal = 2, Nombre = "Centro" },
                new Sucursal { IdSucursal = 3, Nombre = "Norte" },
                new Sucursal { IdSucursal = 4, Nombre = "Sur" }
            };

            catalogoMedicamentos = new List<Medicamento>
            {
                new Medicamento { IdMedicamento = 1, Nombre = "Amoxicilina Veterinaria 250mg" },
                new Medicamento { IdMedicamento = 2, Nombre = "Meloxicam Gotas 15ml" },
                new Medicamento { IdMedicamento = 3, Nombre = "Ivermectina Solución 1%" },
                new Medicamento { IdMedicamento = 4, Nombre = "Vacuna Séxtuple Canina" },
                new Medicamento { IdMedicamento = 5, Nombre = "Vacuna Triple Felina" },
                new Medicamento { IdMedicamento = 6, Nombre = "Desparasitante Drontal Plus" },
                new Medicamento { IdMedicamento = 7, Nombre = "Cefalexina Tabletas 500mg" }
            };

    
            AgregarInventarioInicial(1, 1, 25);
            AgregarInventarioInicial(1, 2, 14);
            AgregarInventarioInicial(1, 4, 30);
            AgregarInventarioInicial(2, 1, 10);
            AgregarInventarioInicial(2, 5, 18);
            AgregarInventarioInicial(3, 3, 22);
            AgregarInventarioInicial(4, 6, 40);
        }

        private void AgregarInventarioInicial(int idSucursal, int idMed, int existencia)
        {
            var suc = listaSucursales.First(s => s.IdSucursal == idSucursal);
            var med = catalogoMedicamentos.First(m => m.IdMedicamento == idMed);

            listaInventario.Add(new InventarioItem
            {
                IdInventario = siguienteIdInventario++,
                IdSucursal = suc.IdSucursal,
                NombreSucursal = suc.Nombre,
                IdMedicamento = med.IdMedicamento,
                NombreMedicamento = med.Nombre,
                Existencia = existencia
            });
        }

        private void CargarCombos()
        {
            cbSucursal.DataSource = listaSucursales;
            cbSucursal.DisplayMember = "Nombre";
            cbSucursal.ValueMember = "IdSucursal";

            cbMedicamento.DataSource = catalogoMedicamentos;
            cbMedicamento.DisplayMember = "Nombre";
            cbMedicamento.ValueMember = "IdMedicamento";

            if (cbSucursal.Items.Count > 0)
            {
                cbSucursal.SelectedIndex = 0;
                MostrarInventarioPorSucursal();
            }
        }

        private void MostrarInventarioPorSucursal(string filtroNombre = "")
        {
            if (cbSucursal.SelectedItem is not Sucursal sucursalActual)
                return;

            dgvInventario.Rows.Clear();

            var consulta = listaInventario
                .Where(i => i.IdSucursal == sucursalActual.IdSucursal);

            if (!string.IsNullOrWhiteSpace(filtroNombre))
            {
                consulta = consulta.Where(i =>
                    i.NombreMedicamento.Contains(filtroNombre.Trim(), StringComparison.OrdinalIgnoreCase));
            }

            foreach (var item in consulta)
            {
                dgvInventario.Rows.Add(item.IdInventario, item.NombreMedicamento, item.Existencia);
            }

            if (dgvInventario.Rows.Count == 0)
            {
                LimpiarSeleccion();
            }
        }

        private void LimpiarSeleccion()
        {
            textBox1.Clear();
            modExistencia.Value = 0;
        }

   
        private void cbSucursal_SelectedIndexChanged(object sender, EventArgs e)
        {
            Med.Clear();
            MostrarInventarioPorSucursal();
        }

        private void dgvInventario_SelectionChanged(object sender, EventArgs e)
        {
            if (dgvInventario.SelectedRows.Count == 0)
                return;

            DataGridViewRow fila = dgvInventario.SelectedRows[0];
            if (fila.Cells["idInventario"].Value == null)
                return;

            int idInv = Convert.ToInt32(fila.Cells["idInventario"].Value);
            string nombreMed = fila.Cells["ColumnMed"].Value?.ToString() ?? "";
            int existencia = Convert.ToInt32(fila.Cells["ColumnExistencia"].Value);

            textBox1.Text = idInv.ToString();
            modExistencia.Value = existencia;

            var medEncontrado = catalogoMedicamentos.FirstOrDefault(m => m.Nombre == nombreMed);
            if (medEncontrado != null)
            {
                cbMedicamento.SelectedItem = medEncontrado;
            }
        }

      
        private void buttonBuscar_Click(object sender, EventArgs e)
        {
            MostrarInventarioPorSucursal(Med.Text);
        }

  
        private void buttonLeer_Click(object sender, EventArgs e)
        {
            Med.Clear();
            MostrarInventarioPorSucursal();
        }

        private void buttonCrear_Click(object sender, EventArgs e)
        {
            if (cbSucursal.SelectedItem is not Sucursal sucursalActual ||
                cbMedicamento.SelectedItem is not Medicamento medSeleccionado)
            {
                MessageBox.Show("Seleccione una sucursal y un medicamento válidos.",
                    "Aviso", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            int nuevaCantidad = (int)modExistencia.Value;


            var existente = listaInventario.FirstOrDefault(i =>
                i.IdSucursal == sucursalActual.IdSucursal &&
                i.IdMedicamento == medSeleccionado.IdMedicamento);

            if (existente != null)
            {
                MessageBox.Show($"El medicamento '{medSeleccionado.Nombre}' ya está registrado en la sucursal {sucursalActual.Nombre} (ID Inventario: {existente.IdInventario}).\n\nUtilice el botón 'Actualizar' para modificar su existencia.",
                    "Registro duplicado", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            var nuevoItem = new InventarioItem
            {
                IdInventario = siguienteIdInventario++,
                IdSucursal = sucursalActual.IdSucursal,
                NombreSucursal = sucursalActual.Nombre,
                IdMedicamento = medSeleccionado.IdMedicamento,
                NombreMedicamento = medSeleccionado.Nombre,
                Existencia = nuevaCantidad
            };

            listaInventario.Add(nuevoItem);
            MostrarInventarioPorSucursal(Med.Text);

            MessageBox.Show("Medicamento agregado correctamente al inventario de la sucursal.",
                "Éxito", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void buttonActualizarExist_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(textBox1.Text) || !int.TryParse(textBox1.Text, out int idInv))
            {
                MessageBox.Show("Seleccione primero un registro de la tabla para actualizar su existencia.",
                    "Aviso", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var item = listaInventario.FirstOrDefault(i => i.IdInventario == idInv);
            if (item == null)
            {
                MessageBox.Show("No se encontró el registro de inventario especificado.",
                    "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            item.Existencia = (int)modExistencia.Value;
            MostrarInventarioPorSucursal(Med.Text);

            MessageBox.Show($"Existencia actualizada a {item.Existencia} unidades para '{item.NombreMedicamento}'.",
                "Actualización exitosa", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void buttonEliminar_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(textBox1.Text) || !int.TryParse(textBox1.Text, out int idInv))
            {
                MessageBox.Show("Seleccione un registro de la tabla para eliminarlo.",
                    "Aviso", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var item = listaInventario.FirstOrDefault(i => i.IdInventario == idInv);
            if (item == null)
                return;

            DialogResult confirmacion = MessageBox.Show(
                $"¿Está seguro de eliminar '{item.NombreMedicamento}' del inventario de la sucursal {item.NombreSucursal}?",
                "Confirmar eliminación",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Question);

            if (confirmacion == DialogResult.Yes)
            {
                listaInventario.Remove(item);
                LimpiarSeleccion();
                MostrarInventarioPorSucursal(Med.Text);

                MessageBox.Show("Registro eliminado correctamente.",
                    "Eliminado", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }


